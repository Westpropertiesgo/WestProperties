# Copy this file to .env.local and fill in your own key to activate the
# AI Property Assistant with real LLM responses.
# Get a key from https://console.anthropic.com

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required for the interactive property map (app/map-search).
# Get a free token from https://account.mapbox.com/access-tokens
# This is a PUBLIC token by design (Mapbox tokens are meant to be used
# client-side) — restrict it to your domain in the Mapbox dashboard for
# production rather than treating it as a secret.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token-here
